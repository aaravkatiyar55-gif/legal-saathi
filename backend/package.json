{
  "name": "legal-sathi-backend",
  "version": "0.1.0",
  "description": "Mock-first Node.js TypeScript Express backend for Legal Saathi.",
  "main": "dist/index.js",
  "scripts": {
    "predev": "npm run rag:ingest",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "rag:ingest": "tsx src/services/rag/rag.ingest.ts",
    "rag:test": "tsx src/services/rag/rag.test.ts",
    "product:test": "tsx src/services/billing/productPolicy.test.ts",
    "pricing:test": "tsx src/services/billing/commercialPricing.test.ts",
    "coupon:test": "tsx src/services/payments/annualCoupon.test.ts",
    "topup:test": "tsx src/services/payments/topUpPolicy.test.ts",
    "model:test": "tsx src/services/ai/modelRouting.test.ts",
    "intent:test": "tsx src/services/ai/legalIntent.test.ts",
    "product-identity:test": "tsx src/services/ai/productIdentity.test.ts",
    "agent:test": "tsx src/services/ai/legalAgent.test.ts",
    "confidentiality:test": "tsx src/services/ai/confidentiality.test.ts",
    "provider:test": "tsx src/services/ai/legalChatProvider.test.ts",
    "receipt:test": "tsx src/services/ai/aiRequestReceipt.test.ts",
    "recovery:test": "tsx src/services/ai/aiRequestRecovery.test.ts",
    "web:test": "tsx src/services/ai/webSearch.test.ts && tsx src/services/ai/webQuota.test.ts",
    "key-pool:test": "tsx src/services/ai/openRouterKeyPool.test.ts",
    "catalog:test": "tsx src/services/ai/openRouterCatalog.test.ts",
    "plan-sync:test": "tsx src/services/admin/adminPlanChange.test.ts",
    "admin-auth:test": "tsx src/services/admin/adminAuthorization.test.ts",
    "case-capacity:test": "tsx src/services/legal/caseCapacity.test.ts",
    "case-workspace:test": "tsx src/services/documents/documentWorkspace.test.ts && tsx src/services/legal/casePersistence.test.ts",
    "image-dimensions:test": "tsx src/services/documents/imageDimensions.test.ts",
    "mfa:test": "tsx src/services/security/supabaseMfa.test.ts && tsx src/services/auth/supabasePrimaryAuth.test.ts",
    "consent:test": "tsx src/services/consent/consent.test.ts",
    "capabilities:test": "tsx src/services/supabase/capabilityRegistry.test.ts",
    "two-factor:test": "tsx src/services/security/twoFactorReadiness.test.ts",
    "provider-session:test": "tsx src/services/auth/providerSessionValidation.test.ts",
    "pending-auth:test": "tsx src/services/auth/pendingAuthSession.test.ts",
    "session-schema:test": "tsx src/services/sessions/sessionSchema.test.ts",
    "session-revocation:test": "tsx src/services/local/authSessions.test.ts",
    "incident:test": "tsx src/services/incidents/incident.test.ts",
    "chat-store:test": "tsx src/services/chats/chatStore.test.ts",
    "memory:test": "tsx src/services/chats/conversationMemory.test.ts && tsx src/services/chats/chatStore.test.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.0.0",
    "image-size": "2.0.2",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "read-excel-file": "8.0.3",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "fast-xml-parser": "5.10.1"
  }
}
